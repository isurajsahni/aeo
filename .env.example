# Copy to .env at the repo root:  cp .env.example .env
# The server loads this file; the client only reads variables prefixed with VITE_.

# --- Server ---
# Don't set NODE_ENV here: Vite reads this file too, and NODE_ENV=development would make
# `npm run build` produce a development bundle. The server defaults to development;
# set NODE_ENV=production in your deployment environment instead.
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (CORS).
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (0 when running locally).
# Needed for correct client IPs in rate limiting behind Nginx/a load balancer.
TRUST_PROXY=0

# Serve the built React app from Express. Defaults to true in production; set false when
# Vercel (or another static host) serves the UI.
# SERVE_CLIENT=false

# --- Sign-ups ---
# Set to false after creating your own account to make the workspace invite-only.
ALLOW_REGISTRATION=true
# Optional comma-separated allowlist of emails and/or @domains, e.g. @youragency.com,client@gmail.com
SIGNUP_ALLOWLIST=

# --- Database / queue ---
MONGODB_URI=mongodb://127.0.0.1:27017/aeo_audit
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
# Session length, e.g. 15m, 12h, 7d
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Defaults to true when NODE_ENV=production. Set false only if serving over plain HTTP.
# COOKIE_SECURE=true

# --- Crawler ---
# Identify the crawler clearly; site owners can target the token in robots.txt.
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; AEOAuditBot/1.0; +https://github.com/aeo-audit)
CRAWLER_ROBOTS_TOKEN=AEOAuditBot
# Minimum delay between requests to the same host (robots.txt Crawl-delay is honoured if larger).
CRAWL_DELAY_MS=500
FETCH_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=5
MAX_CONCURRENT_AUDITS=2
# Site crawls: default and maximum pages per crawl.
DEFAULT_CRAWL_PAGES=25
MAX_CRAWL_PAGES=100

# --- Job queue (BullMQ + Redis) ---
# auto = BullMQ when Redis is reachable, otherwise an in-process runner (with a warning).
# bullmq = require Redis. inline = never use Redis.
QUEUE_DRIVER=auto
# Run the audit worker inside the API process. Set false if you run `npm run worker` separately.
RUN_WORKER=true

# --- JavaScript rendering (Playwright) ---
# Requires: npx playwright install chromium-headless-shell
RENDER_ENABLED=true
RENDER_TIMEOUT_MS=25000
# In site crawls, only the first N pages are rendered (Chromium is slow).
RENDER_MAX_PAGES=3

# --- AI visibility testing (category F) ---
# Each AI assistant is enabled when its key is set. Requests use web search and are billed to these keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: only use these providers even if more keys are set (comma-separated: openai,anthropic,perplexity,gemini).
VISIBILITY_PROVIDERS=
VISIBILITY_RUNS_PER_PROMPT=3
VISIBILITY_MAX_PROMPTS=50
VISIBILITY_MAX_CALLS_PER_RUN=400
VISIBILITY_CONCURRENCY=3
VISIBILITY_TIMEOUT_MS=120000
# Audits include category F from the latest test no older than this.
VISIBILITY_MAX_AGE_DAYS=30

# --- Google PageSpeed Insights (Core Web Vitals) ---
# Works without a key but the shared quota is tiny. Free key:
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_ENABLED=true
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=60000

# --- Seed script (npm run seed) ---
SEED_USER_NAME=Demo Agency
SEED_USER_EMAIL=demo@aeoaudit.local
SEED_USER_PASSWORD=DemoPass123

# --- Client (Vite) ---
# Leave empty in development: Vite proxies /api to the server.
# Set to the API origin in production if the client is hosted separately.
VITE_API_URL=
