{
  "name": "@aeo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "db:local": "node scripts/devdb.js",
    "worker": "node worker.js",
    "redis:local": "node scripts/devredis.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "transform": {},
    "testTimeout": 30000
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.29.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.15",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "openai": "^7.33.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "playwright": "^1.64.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "redis-memory-server": "^0.17.1",
    "supertest": "^7.3.1"
  }
}
